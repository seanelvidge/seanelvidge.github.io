---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign url_beginning = page.url | slice: 0, 6 %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      {{ page.date | date: '%B %d, %Y' }}
      •
      {% if page.author -%}
        {{- page.author -}}
      {%- else -%}
        <a href="{{ '/about/' | relative_url }}">Sean Elvidge</a>
      {%- endif %}
      {% if page.last_modified_at %} · Updated {{ page.last_modified_at | date: '%B %d, %Y' }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
    </p>
    <p class="post-tags">
      {% if page.collection == 'posts' %}
        <a href="{{ year | prepend: '/articles/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} </a>
      {% else %}
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
      {% endif %}
      {% if tags != '' %}
        &nbsp; &middot; &nbsp;
        {% for tag in page.tags %}
          {% if page.collection == 'posts' %}
            <a href="{{ tag | slugify | prepend: '/articles/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
            &nbsp;
          {% else %}
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }} &nbsp;
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if categories != '' %}
        &nbsp; &middot; &nbsp;
        {% for category in page.categories %}
          {% if page.collection == 'posts' %}
            <a href="{{ category | slugify | prepend: '/articles/category/' | relative_url }}">
              <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}
            </a>
            &nbsp;
          {% else %}
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }} &nbsp;
          {% endif %}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.tags contains 'football' or page.tags contains 'mathematics' or page.tags contains 'spaceWeather' %}
    <div class="article-topic-link">{% include topic-links.liquid %}</div>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
