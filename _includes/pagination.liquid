{% if paginator.total_pages > 1 %}
  <nav class="article-pagination" aria-label="Article pages">
    <ul class="pagination pagination-lg justify-content-center">
      <li class="page-item {% unless paginator.previous_page %}disabled{% endunless %}">
        <a
          class="page-link"
          href="{{ paginator.previous_page_path | relative_url }}"
          {% unless paginator.previous_page %}
            tabindex="-1" aria-disabled="true"
          {% endunless %}
          >Newer</a
        >
      </li>
      {% if paginator.page_trail %}
        {% for trail in paginator.page_trail %}
          <li class="page-item {% if paginator.page == trail.num %}active{% endif %}">
            <a
              class="page-link"
              href="{{ trail.path | relative_url }}"
              title="{{trail.title}}"
              {% if paginator.page == trail.num %}
                aria-current="page"
              {% endif %}
            >
              {{- trail.num -}}
            </a>
          </li>
        {% endfor %}
      {% endif %}
      <li class="page-item {% unless paginator.next_page %}disabled{% endunless %}">
        <a
          class="page-link"
          href="{{ paginator.next_page_path | relative_url }}"
          {% unless paginator.next_page %}
            tabindex="-1" aria-disabled="true"
          {% endunless %}
          >Older</a
        >
      </li>
    </ul>
  </nav>
{% endif %}
