<!-- One metadata renderer: Jekyll SEO Tag owns titles, descriptions, canonicals, social cards and page/article JSON-LD. -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
{% seo %}
{% if page.noindex or page.redirect %}
  <meta name="robots" content="noindex, follow">
{% endif %}
{% if page.url == '/' or page.url == '/index.html' or page.url == '/about/' %}
  {% include person-schema.liquid %}
{% endif %}
