<script type="application/json" id="football-team-route-data">
  {
    "teamsRoot": {{ '/teams/' | relative_url | jsonify }},
    "home": {{ '/' | relative_url | jsonify }},
    "aliases": {
      {% for alias in site.data.football_teams.aliases.lookup %}
        {{ alias[0] | jsonify }}: {{ alias[1] | relative_url | jsonify }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }
  }
</script>
<script src="{{ '/assets/js/football-team-routes.js' | relative_url | bust_file_cache }}"></script>
